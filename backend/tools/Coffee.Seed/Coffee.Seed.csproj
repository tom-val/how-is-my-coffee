<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Coffee.Seed</RootNamespace>
    <AssemblyName>Coffee.Seed</AssemblyName>
    <!-- A dev-only tool: never published to Lambda, so no AOT constraints apply here. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reused for PasswordHasher and the single-table key/attribute constants, so the seed can
         never drift from what the API reads. -->
    <ProjectReference Include="../../src/Coffee.Api/Coffee.Api.csproj" />
  </ItemGroup>

</Project>
