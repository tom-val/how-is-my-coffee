<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Coffee.Api</RootNamespace>
    <AssemblyName>Coffee.Api</AssemblyName>
    <!-- Native AOT for Lambda (provided.al2023, arm64): compiled ahead of time, so there is no
         first-request JIT — the cold start we are trying to kill. The deploy workflow publishes
         linux-arm64 and ships the native executable as `bootstrap`. PublishAot only affects
         `dotnet publish`; `dotnet build` / `dotnet test` still run JIT'd, so the test projects
         are unaffected. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Guard against duplicate / unsupported source-gen JSON types (our code, Roslyn-only). The
         IL2026/IL3050 trim/AOT IDs are intentionally NOT errors: the AWS SDK + the Amazon.Lambda
         serializer emit them unavoidably at ILC time (rooted assemblies / a reflection path we
         never invoke), which would fail the native compile. A reintroduced anonymous-object
         response still surfaces as an IL warning and fails the integration tests at runtime. -->
    <WarningsAsErrors>$(WarningsAsErrors);SYSLIB1031</WarningsAsErrors>
  </PropertyGroup>

  <!-- Local-only secrets (Google:PlacesApiKey). Gitignored and copied next to the binary so a local
       run picks it up, but never published: it must not end up inside a Lambda zip. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coffee.Api.Tests" />
    <InternalsVisibleTo Include="Coffee.Api.IntegrationTests" />
    <InternalsVisibleTo Include="Coffee.Seed" />
  </ItemGroup>

  <!-- The AWS SDK marshals requests/responses with reflection the trimmer cannot prove safe; root
       the whole assemblies so their code survives trimming (bigger binary, correct at runtime). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="AWSSDK.Core" />
    <TrimmerRootAssembly Include="AWSSDK.DynamoDBv2" />
    <TrimmerRootAssembly Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.7.2" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.4" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.405.19" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.412.5" />
  </ItemGroup>

</Project>
