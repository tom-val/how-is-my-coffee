<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Coffee.Api.IntegrationTests</RootNamespace>
    <AssemblyName>Coffee.Api.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Lets the whole suite report as skipped (with a reason) when Docker isn't running, instead of
         failing a laptop or a CI job that has no DynamoDB Local. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.405.19" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.412.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Coffee.Api/Coffee.Api.csproj" />
  </ItemGroup>

</Project>
