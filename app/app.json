{
  "expo": {
    "name": "Kavutė",
    "slug": "kavute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kavute",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tomval.kavute",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.tomval.kavute",
      "adaptiveIcon": {
        "backgroundColor": "#6F4E37",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3E9DE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#211A16",
            "image": "./assets/splash-icon.png",
            "imageWidth": 140
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kavutė to access your photos so you can attach one to a rating.",
          "cameraPermission": "Allow Kavutė to use the camera so you can photograph your coffee."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kavutė to use your location to find the cafe you are in."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6F4E37"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "862a20c9-d4f3-4c81-a791-5db00e8657b3"
      }
    },
    "owner": "smikis",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/862a20c9-d4f3-4c81-a791-5db00e8657b3"
    }
  }
}
