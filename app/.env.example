# Public client config (EXPO_PUBLIC_* is inlined into the bundle at build time — never put secrets here).
#
# Base URL of the coffee API, WITHOUT a trailing slash and WITHOUT the /v1 prefix:
#   local dev      http://localhost:5090
#   production     https://<cloudfront-domain>      (CloudFront forwards /v1/* to API Gateway)
# On iOS/Android in development this is ignored: the app reuses the Metro dev-server host on
# port 5090, so a phone on the same Wi-Fi reaches the API with no edit here (see src/lib/devHost).
EXPO_PUBLIC_API_URL=http://localhost:5090

# Google Maps key for the ANDROID map only (react-native-maps uses Google Maps there).
# iOS uses Apple Maps and the web uses Leaflet + OpenStreetMap, so neither needs a key.
# Leave this empty and the Android build still runs — the map just draws an empty tile background
# under the pins instead of real tiles. Get a key in the Google Cloud console ("Maps SDK for
# Android") and restrict it to the app's package + signing certificate.
# It is read by app.config.ts, which injects it as android.config.googleMaps.apiKey.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
